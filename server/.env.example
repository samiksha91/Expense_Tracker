# Server configuration
NODE_ENV=development
PORT=3001

# PostgreSQL connection strings (use real values in your local .env, never commit them)
DATABASE_URL=postgresql://postgres:password@localhost:5432/expense_tracker
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/expense_tracker_test

# JSON Web Token configuration
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1h

# Allowed CORS origin (the frontend URL)
FRONTEND_URL=http://localhost:5173

# Set to true in production so the auth cookie is sent only over HTTPS
COOKIE_SECURE=false
